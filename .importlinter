[importlinter]
root_packages =
    core
    adapters

[importlinter:contract:core-no-adapters]
name = Core must not depend on adapters (AD-1)
type = forbidden
source_modules =
    core
forbidden_modules =
    adapters

[importlinter:contract:adapters-no-pipeline]
name = Adapters must not depend on core pipeline (AD-1)
type = forbidden
source_modules =
    adapters
forbidden_modules =
    core.fetch
    core.clean
    core.epub
    core.tts
    core.merge
    core.aggregator
    core.pipeline
    core.config
