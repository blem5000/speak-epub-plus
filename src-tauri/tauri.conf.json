{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speak EPUB",
  "version": "0.3.20",
  "identifier": "com.speakepub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Speak EPUB",
        "width": 960,
        "minWidth": 900,
        "height": 640,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; object-src 'none'; connect-src 'self' http://localhost:* https://* ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/speak-epub/**",
          "$APPDATA/speak-epub/**",
          "$APPLOCALDATA/speak-epub/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["sidecar-runtime"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNkU4MzE1NjE4QjEyQUIKUldTckVvdGhGWU51SDRsQlFVbGJKaFY5TTRveHpTa3VDNHRsVnJCOTFaR3F2eGZRSzlUUXVLR3IK",
      "endpoints": [
        "https://github.com/blem5000/speak-epub-plus/releases/latest/download/latest.json"
      ]
    }
  }
}
