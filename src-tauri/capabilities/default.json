{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — shell + store + core events",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "shell:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-load",
    "store:allow-save",
    "opener:default",
    "opener:allow-open-path"
  ]
}
